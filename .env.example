# backend
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/min_trello
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/min_trello_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_GRACE_SECONDS=60
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
PORT=3000

# frontend (dev; в prod используется same-origin /api через edge nginx)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# docker compose (optional; container-internal defaults are used when unset).
# Пока определён только этот блок — dev-значения выше указывают на localhost и в
# контейнерах не работают, поэтому у docker-стека свой префикс MIN_TRELLO_*.
# HTTP_PORT=80
# MIN_TRELLO_DATABASE_URL=postgresql://postgres:postgres@db:5432/min_trello
# MIN_TRELLO_REDIS_URL=redis://redis:6379
# MIN_TRELLO_CORS_ORIGIN=http://localhost
# MIN_TRELLO_VITE_API_URL=/api
# MIN_TRELLO_VITE_WS_URL=/
