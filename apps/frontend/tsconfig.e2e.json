{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "baseUrl": "."
  },
  "include": ["e2e", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "e2e/.auth"]
}
