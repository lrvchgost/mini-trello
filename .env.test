# Vitest (Vite mode=test). Absolute URLs so ky + MSW (node interceptor) can parse
# requests even when neither the developer nor CI has a root .env — vite.config.ts
# sets envDir to the repo root, so this file is picked up automatically.
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
